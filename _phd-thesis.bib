@article{bock2010subwavelength,
  author    = {Przemek J. Bock and Pavel Cheben and Jens H. Schmid and Jean Lapointe and Andr\'{e} Del\^{a}ge and Dan-Xia Xu and Siegfried Janz and Adam Densmore and Trevor J. Hall},
  journal   = {Opt. Express},
  keywords  = {Diffraction gratings; Integrated optics devices; Subwavelength structures ; Effective refractive index; Electron beam lithography; Fiber optic couplers; Glass waveguides; Photonic crystal cavities; Waveguide gratings},
  number    = {15},
  pages     = {16146--16155},
  publisher = {Optica Publishing Group},
  title     = {Subwavelength grating crossings for silicon wire waveguides},
  volume    = {18},
  month     = {Jul},
  year      = {2010},
  url       = {https://opg.optica.org/oe/abstract.cfm?URI=oe-18-15-16146},
  doi       = {10.1364/OE.18.016146},
  abstract  = {We report on the design, simulation and experimental demonstration of a new type of waveguide crossing based on subwavelength gratings in silicon waveguides. We used 3D finite-difference time-domain simulations to minimize loss, crosstalk and polarization dependence. Measurement of fabricated devices show that our waveguide crossings have a loss as low as {\textminus}0.023 dB/crossing, polarization dependent loss of \&lt; 0.02 dB and crosstalk \&lt;-40 dB.}
