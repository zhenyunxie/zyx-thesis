  author    = {Ryohei Urata and Hong Liu and Kevin Yasumura and Erji Mao and Jill Berger and Xiang Zhou and Cedric Lam and Roy Bannon and Darren Hutchinson and Daniel Nelson and Leon Poutievski and Arjun Singh and Joon Ong and Amin Vahdat},
  booktitle = {Optical Fiber Communication Conference (OFC) 2023},
