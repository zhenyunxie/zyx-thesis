@article{tanizawa2016novelpola,
  author    = {Ken Tanizawa and Keijiro Suzuki and Kazuhiro Ikeda and Shu Namiki and Hitoshi Kawashima},
  journal   = {Opt. Express},
  keywords  = {Photonic integrated circuits; Optical switching devices ; Beam splitters; Integrated photonics; Optical directional couplers; Optical networks; Photonic integrated circuits; Signal processing},
  number    = {7},
  pages     = {6861--6868},
  publisher = {Optica Publishing Group},
  title     = {Novel polarization diversity without switch duplication of a Si-wire PILOSS optical switch},
  volume    = {24},
  month     = {Apr},
  year      = {2016},
  url       = {https://opg.optica.org/oe/abstract.cfm?URI=oe-24-7-6861},
  doi       = {10.1364/OE.24.006861},
  abstract  = {We demonstrate the compact polarization diversity based on the bidirectional full-port use of a path-independent-insertion-loss (PILOSS) optical switch. A polarization-diversity 4 \&\#x00D7; 4 strictly non-blocking optical switch is developed using a single thermooptic PILOSS Si-wire switch and fiber-based polarization beam splitters (PBSs) and combiners (PBCs). We measure characteristics of the switch and confirm that the proposed configuration demonstrates the performance in the insertion loss, polarization-dependent loss (PDL), and differential group delay (DGD) comparable with that of a conventional polarization-diversity 4 \&\#x00D7; 4 PILOSS switch using double switch elements. On the other hand, higher crosstalk is observed. The crosstalk increase is associated with the backward crosstalk at a waveguide intersection based on a directional coupler. The effect of the backward crosstalk on the total crosstalk is estimated, and future prospects are discussed.}
}

@article{kurosu2019high,
  author    = {Takayuki Kurosu and Takashi Inoue and Keijiro Suzuki and Satoshi Suda and Shu Namiki},
  journal   = {J. Lightwave Technol.},
  keywords  = {High throughput optics; Optical networks; Q factor; Signal processing; Silicon photonics; Variable optical attenuators},
  number    = {1},
  pages     = {131--137},
  publisher = {Optica Publishing Group},
  title     = {High-Capacity Multi-Stage Operation of Polarization-Diversity Silicon Photonics 8 {\texttimes} 8 Optical Switch},
  volume    = {37},
  month     = {Jan},
  year      = {2019},
  url       = {https://opg.optica.org/jlt/abstract.cfm?URI=jlt-37-1-131},
  abstract  = {For practical and wide use of optical switches, cascadability and high throughput are of great significance. We demonstrate up to 8-stage cascaded operation of a polarization-independent silicon photonics 8 {\texttimes} 8 optical switch where 11-channel 32/44-Gbaud DP-16QAM signals are loaded up on all the paths in a cyclic way. The results verify that the 8 {\texttimes} 8 switch is capable of offering a throughput of 48.2 Tb/s with a wall-plug energy efficiency of 0.37 pJ/bit. Using an additional optical module with the characteristics equivalent to the 8 {\texttimes} 8 switch, 9-stage cascaded operation is also emulated. The successful performance observed in these experiments promises the realization of optical switch fabrics with higher port counts by arranging the 8 {\texttimes} 8 switches in a multi-folded Clos network.}
}

