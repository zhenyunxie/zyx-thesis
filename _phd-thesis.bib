@article{papadimitriou2003optical,
  author    = {Georgios I. Papadimitriou and Chrisoula Papazoglou and Andreas S. Pomportsis},
  journal   = {J. Lightwave Technol.},
  keywords  = {},
  number    = {2},
  pages     = {384},
  publisher = {Optica Publishing Group},
  title     = {Optical Switching: Switch Fabrics, Techniques, and Architectures},
  volume    = {21},
  month     = {Feb},
  year      = {2003},
  url       = {https://opg.optica.org/jlt/abstract.cfm?URI=jlt-21-2-384},
  abstract  = {The switching speeds of electronics cannot keep up with the transmission capacity offered by optics. All-optical switch fabrics play a central role in the effort to migrate the switching functions to the optical layer. Optical packet switching provides an almost arbitrary fine granularity but faces significant challenges in the processing and buffering of bits at high speeds. Generalized multiprotocol label switching seeks to eliminate the asynchronous transfer mode and synchronous optical network layers, thus implementing Internet protocol over wavelength-division multiplexing. Optical burst switching attempts to minimize the need for processing and buffering by aggregating flows of data packets into bursts. In this paper, we present an extensive overview of the current technologies and techniques concerning optical switching.}
}

@article{lubidirectionalcon,
  author   = {Lu, Yang and Xu, Kaiqiang and Lu, Zhijun and Yang, Haoyu and Zhai, Yanrong and Bi, Meihua},
  title    = {Bidirectional passive optical interconnected data center},
  journal  = {Microwave and Optical Technology Letters},
  volume   = {66},
  number   = {6},
  pages    = {e34133},
  keywords = {bidirectional transmission, data centers, passive interconnection},
  doi      = {https://doi.org/10.1002/mop.34133},
  url      = {https://onlinelibrary.wiley.com/doi/abs/10.1002/mop.34133},
  abstract = {Abstract A novel bidirectional passive optical interconnection is proposed for data centers (DCs). The interconnection is based on a coupler of arrayed waveguide grating. The nodes distribute on both sides and simultaneously, bidirectional transmission is allowed. Compared with the traditional passive optical interconnected DCs, the scale is doubled, and the throughput is increased. The crosstalk in simultaneously bidirectional transmission is tested and the results show it is very little. The transmission between the nodes on the same side is relayed by one node on the other side. Some relay methods are proposed, and the relay efficiency is evaluated.},
  year     = {2024}
