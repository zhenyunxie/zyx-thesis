  langid       = {english},
  keywords     = {Highlight},
  file         = {Cheng et al. - 2020 - Silicon Photonic Switch Topologies and Routing Str.pdf:/Users/zhenyunxie/Zotero/storage/99SIBIVA/Cheng et al. - 2020 - Silicon Photonic Switch Topologies and Routing Str.pdf:application/pdf}
