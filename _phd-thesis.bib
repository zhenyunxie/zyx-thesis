@article{gupta2018performance,
  author    = {Ramesh K. Gupta and Bijoy K. Das},
  journal   = {OSA Continuum},
  keywords  = {CMOS technology; Numerical simulation; Phase shift; Silicon photonics; Waveguide cores; Waveguide design},
  number    = {2},
  pages     = {703--714},
  publisher = {Optica Publishing Group},
  title     = {Performance analysis of metal-microheater integrated silicon waveguide phase-shifters},
  volume    = {1},
  month     = {Oct},
  year      = {2018},
  url       = {https://opg.optica.org/osac/abstract.cfm?URI=osac-1-2-703},
  doi       = {10.1364/OSAC.1.000703},
  abstract  = {A detailed theoretical and experimental study of metal-microheater integrated silicon waveguide phase-shifters has been carried out. It has been shown that the effective thermal conductance gw and the effective heat capacitance hw evaluated per unit length of the waveguide are two useful parameters contributing to the overall performance of a thermo-optic phase-shifter. Calculated values of temperature sensitivity, SH \&\#x0003D; 1/gw and thermal response time, \&\#x003C4;th \&\#x0003D; hw/gw of the phase-shifter are found to be consistent with the experimental results. Thus, a new parameter \&\#x02131;H \&\#x0003D; SH/\&\#x003C4;th \&\#x0003D; 1/hw has been introduced to capture the overall figure of merit of a thermo-optic phase-shifter. A folded waveguide phase-shifter design integrated in one of the arms of a balanced MZI switch is shown to be superior to that of a straight waveguide phase-shifter of the same waveguide cross-sectional geometry. The MZI switches were designed to operate in TE-polarization over a broad wavelength range (\&\#x003BB; \&\#x0223C; 1550 nm).}
}

