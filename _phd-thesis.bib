@article{song2022toward,
  author    = {Lijia Song and Tangnan Chen and Weixi Liu and Hongxuan Liu and Yingying Peng and Zejie Yu and Huan Li and Yaocheng Shi and Daoxin Dai},
  journal   = {Photon. Res.},
  keywords  = {Extinction ratios; Optical filters; Optical systems; Phase compensation; Silicon photonics; Variable optical attenuators},
  number    = {3},
  pages     = {793--801},
  publisher = {Optica Publishing Group},
  title     = {Toward calibration-free Mach\&\#x2013;Zehnder switches for next-generation silicon photonics},
  volume    = {10},
  month     = {Mar},
  year      = {2022},
  url       = {https://opg.optica.org/prj/abstract.cfm?URI=prj-10-3-793},
  doi       = {10.1364/PRJ.447478},
  abstract  = {Silicon photonic Mach\&\#x2013;Zehnder switches (MZSs) have been extensively investigated as a promising candidate for optical systems. However, conventional 2\&\#x00D7;2 MZSs are usually prone to the size variations of the arm waveguides due to imperfect fabrication, resulting in considerable random phase imbalance between the two arms, thereby imposing significant challenges for further developing next-generation N\&\#x00D7;N MZSs. Here we propose a novel design toward calibration-free 2\&\#x00D7;2 and N\&\#x00D7;N MZSs, employing optimally widened arm waveguides, enabled by novel compact tapered Euler S-bends with incorporated mode filters. With standard 180\&\#x00A0;nm CMOS foundry processes, more than thirty 2\&\#x00D7;2 MZSs and one 4\&\#x00D7;4 Benes MZS with the new design are fabricated and characterized. Compared with their conventional counterparts with 0.45-\&\#x03BC;m-wide arm waveguides, the present 2\&\#x00D7;2 MZSs exhibit significant reduction in the random phase imbalance. The measured extinction ratios of the present 2\&\#x00D7;2 and 4\&\#x00D7;4 MZSs operating in the all-cross state are 27-49\&\#x00A0;dB and \&\#x223C;20\&\#x2009;\&\#x2009;dB across the wavelength range of \&\#x223C;60\&\#x2009;\&\#x2009;nm, respectively, even without any calibrations. This work paves the way toward calibration-free large-scale N\&\#x00D7;N MZSs for next-generation silicon photonics.}
}

