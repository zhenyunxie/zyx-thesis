@article{suzuki2015ultra,
  author    = {Keijiro Suzuki and Guangwei Cong and Ken Tanizawa and Sang-Hun Kim and Kazuhiro Ikeda and Shu Namiki and Hitoshi Kawashima},
  journal   = {Opt. Express},
  keywords  = {Integrated optics devices; Optical switching devices ; Switching ; Complementary metal oxide semiconductors; Extinction ratios; Multi-mode interferometers; Scanning electron microscopy; Silicon photonics; Tunable diode lasers},
  number    = {7},
  pages     = {9086--9092},
  publisher = {Optica Publishing Group},
  title     = {Ultra-high-extinction-ratio 2 {\texttimes} 2 silicon optical switch with variable splitter},
  volume    = {23},
  month     = {Apr},
  year      = {2015},
  url       = {https://opg.optica.org/oe/abstract.cfm?URI=oe-23-7-9086},
  doi       = {10.1364/OE.23.009086},
  abstract  = {We demonstrate a record-high extinction-ratio of 50.4 dB in a 2 {\texttimes} 2 silicon Mach-Zehnder switch equipped with a variable splitter as the front 3-dB splitter. The variable splitter is adjusted to compensate for the splitting-ratio mismatch between the front and rear 3-dB splitters. The high extinction ratio does not rely on waveguide crossings and meets a strong demand in applications to multiport circuit switches. Large fabrication tolerance will make the high extinction ratio compatible with a volume production with standard complementary metal-oxide semiconductor fabrication facilities.}
}

